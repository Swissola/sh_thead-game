# Supabase client env vars (Vite requires the VITE_ prefix to expose these
# to browser code - see .planning/phases/02-real-cross-device-multiplayer/02-RESEARCH.md
# Pitfall 5). Copy this file to .env.local and fill in real values.

# From `npx supabase status` (local dev) -> "API URL", or the hosted project's
# Settings > API > Project URL.
VITE_SUPABASE_URL=https://your-project.supabase.co

# From `npx supabase status` (local dev) -> "Publishable key", or the hosted
# project's Settings > API Keys > Publishable key. Never put the secret/
# service-role key in a VITE_-prefixed variable - it is inlined into the
# shipped browser bundle.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
